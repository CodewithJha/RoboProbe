{
  "uid": "roboprobe-overview",
  "title": "RoboProbe",
  "tags": ["roboprobe"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "timezone": "utc",
  "time": {"from": "now-6h", "to": "now"},
  "editable": false,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Runs per minute by verdict",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (verdict) (rate(roboprobe_runs_total[5m])) * 60"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Run duration p50 / p95",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(roboprobe_run_duration_seconds_bucket[5m])))"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(roboprobe_run_duration_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Queue depth",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "roboprobe_queue_depth"}]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Workers by status",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "roboprobe_workers"}]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Selector propose time",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, strategy) (rate(roboprobe_selector_propose_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "GP fit time",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(roboprobe_gp_fit_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Episode real-time factor",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, backend) (rate(roboprobe_episode_rtf_bucket[5m])))"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Infra errors by reason",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum by (reason) (rate(roboprobe_infra_errors_total[5m]))"}
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "API latency p95 by route",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(roboprobe_api_request_duration_seconds_bucket[5m])))"
        }
      ]
    }
  ]
}
