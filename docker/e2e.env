# Local bindings and runtime settings for the isolated Playwright Compose project.
ROBOPROBE_IMAGE_TAG=e2e
ROBOPROBE_WEB_PORT=8080
ROBOPROBE_K2D_REPLICAS=2
ROBOPROBE_DB_NAME=roboprobe_e2e
ROBOPROBE_STORAGE__ARTIFACT_ROOT=/data/artifacts/e2e
ROBOPROBE_STORAGE__WORKDIR_ROOT=/tmp/roboprobe-work
ROBOPROBE_RUNNER__MAX_BATCH_SIZE=4
ROBOPROBE_RUNNER__MAX_MANUAL_REPEATS=5
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
