# E2E stack overrides (T-117). Composed with repo `.env` when present; tunables live in docs/27.
ROBOPROBE_K2D_REPLICAS=2
ROBOPROBE_RUNNER__MAX_CONCURRENT_CAMPAIGNS=2
ROBOPROBE_API__HOST=0.0.0.0
# CI-only bearer token (not a deployment secret; paired with Playwright sessionStorage).
ROBOPROBE_API__TOKEN=e2e-ci-token
ROBOPROBE_WEB_PORT=8080
ROBOPROBE_DB_PORT=5432