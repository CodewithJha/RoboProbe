# Build context for docker/*.Dockerfile: allow-list only what images need (keeps secrets, .env,
# data/, caches and node_modules out of the context and out of every layer).
*
!backend/pyproject.toml
!backend/uv.lock
!backend/src/
!backend/alembic.ini
!backend/alembic/
!schemas/
!configs/
!tasks/
!plugins/
!web/
!docker/web/
**/node_modules/
web/dist/
web/coverage/
web/playwright-report/
web/test-results/
**/__pycache__/
**/*.py[cod]
**/.DS_Store
