{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CodewithJha/RoboProbe/schemas/manifest.schema.json",
  "title": "RoboProbe provenance manifest",
  "description": "Per-run provenance (docs/21 §4, ADR-0014). Host names are hashed; paths are relative.",
  "type": "object",
  "required": [
    "manifest_schema_version",
    "run_id",
    "campaign_id",
    "roboprobe",
    "backend",
    "space",
    "task",
    "sut_profile",
    "scenario",
    "seeds",
    "materialized",
    "config_snapshot",
    "host",
    "timing"
  ],
  "additionalProperties": false,
  "properties": {
    "manifest_schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1
    },
    "experiment_id": {
      "type": ["string", "null"]
    },
    "roboprobe": {
      "type": "object",
      "required": ["version", "git_sha", "dirty", "uv_lock_sha256"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "git_sha": { "type": "string", "minLength": 1 },
        "dirty": { "type": "boolean" },
        "uv_lock_sha256": { "type": "string", "minLength": 64, "maxLength": 64 }
      }
    },
    "backend": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "image": { "type": "string" },
        "ros_distro": { "type": "string" },
        "gz": { "type": "string" },
        "nav2": { "type": "string" },
        "rmw": { "type": "string" }
      }
    },
    "space": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "task": {
      "type": "object",
      "required": ["id", "sha256"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "minLength": 1 }
      }
    },
    "sut_profile": {
      "type": "object",
      "required": ["id", "config_hash"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "config_hash": { "type": "string", "minLength": 1 }
      }
    },
    "scenario": {
      "type": "object",
      "required": ["hash", "values"],
      "additionalProperties": false,
      "properties": {
        "hash": { "type": "string", "minLength": 1 },
        "values": { "type": "object" }
      }
    },
    "seeds": {
      "type": "object",
      "required": ["run"],
      "additionalProperties": false,
      "properties": {
        "run": { "type": "integer", "minimum": 0 },
        "sensor": { "type": "integer", "minimum": 0 },
        "perception": { "type": "integer", "minimum": 0 },
        "simulator": { "type": "integer", "minimum": 0 },
        "localization": { "type": "integer", "minimum": 0 }
      }
    },
    "materialized": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "config_snapshot": {
      "type": "object",
      "required": ["oracles"],
      "additionalProperties": true,
      "properties": {
        "oracles": { "type": "object" }
      }
    },
    "host": {
      "type": "object",
      "required": ["hostname_hash", "cpu", "cores", "ram_gb"],
      "additionalProperties": false,
      "properties": {
        "hostname_hash": { "type": "string", "minLength": 1 },
        "cpu": { "type": "string" },
        "cores": { "type": "integer", "minimum": 1 },
        "ram_gb": { "type": "number", "minimum": 0 }
      }
    },
    "timing": {
      "type": "object",
      "required": ["wall_s", "sim_s", "rtf_mean"],
      "additionalProperties": false,
      "properties": {
        "wall_s": { "type": "number", "minimum": 0 },
        "sim_s": { "type": "number", "minimum": 0 },
        "rtf_mean": { "type": ["number", "null"] }
      }
    }
  }
}
