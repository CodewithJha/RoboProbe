{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CodewithJha/RoboProbe/schemas/scenario_space.schema.json",
  "title": "RoboProbe scenario space",
  "description": "Scenario space file (docs/06 §4–§5). Semantic checks (low < high, nominal within bounds, unique ids, constraint expressions) are done by the Python loader (T-020b).",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name",
    "task",
    "parameters"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/space_id"
    },
    "name": {
      "type": "string",
      "maxLength": 120
    },
    "description": {
      "type": "string"
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "parameters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/parameter"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "expr"
        ],
        "properties": {
          "expr": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "oracle_thresholds": {
      "oneOf": [
        {
          "const": "default"
        },
        {
          "type": "object"
        }
      ]
    }
  },
  "$defs": {
    "space_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,40}$"
    },
    "parameter": {
      "type": "object",
      "required": [
        "id",
        "name",
        "group",
        "type",
        "unit",
        "nominal",
        "prior"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]+\\.[a-z0-9_]+$",
          "description": "Parameter id `<group>.<name>` (docs/06 §2)."
        },
        "name": {
          "type": "string"
        },
        "group": {
          "enum": [
            "robot",
            "environment",
            "sensor",
            "comms",
            "task"
          ]
        },
        "type": {
          "enum": [
            "float",
            "int",
            "categorical"
          ]
        },
        "unit": {
          "type": "string"
        },
        "low": {
          "type": "number"
        },
        "high": {
          "type": "number"
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2
        },
        "nominal": {
          "type": [
            "number",
            "string"
          ]
        },
        "scale": {
          "enum": [
            "linear",
            "log"
          ],
          "default": "linear"
        },
        "prior": {
          "$ref": "#/$defs/prior"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "description": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "float",
                  "int"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "low",
              "high"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "categorical"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "choices"
            ]
          }
        }
      ]
    },
    "prior": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "uniform",
            "loguniform",
            "truncnormal",
            "beta",
            "discrete"
          ]
        },
        "mean": {
          "type": "number"
        },
        "std": {
          "type": "number"
        },
        "a": {
          "type": "number"
        },
        "b": {
          "type": "number"
        },
        "weights": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      }
    }
  }
}
