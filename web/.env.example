# RoboProbe web — build/dev-time variables (doc 27 §4.11). Copy to `.env.local` to override.
# Every key is optional; the values below are the defaults applied by vite.config.ts.

# Base path (or absolute URL) the dashboard uses to reach the REST API.
VITE_API_BASE_URL=/api/v1

# Dev server only: backend origin that requests under /api are proxied to.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
