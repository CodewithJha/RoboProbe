{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": ["/", "/campaigns", "/settings"],
      "numberOfRuns": 1,
      "settings": { "preset": "desktop", "onlyCategories": ["accessibility", "performance"] }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:performance": ["warn", { "minScore": 0.5 }]
      }
    }
  }
}