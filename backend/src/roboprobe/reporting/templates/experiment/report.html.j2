<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <title>RoboProbe experiment report — {{ context.title }}</title>
  <style>{{ context.css }}</style>
</head>
<body>
  <header>
    <h1>Experiment report</h1>
    <p class="muted">{{ context.experiment_id }}</p>
  </header>

  <section id="design">
    <h2>Design</h2>
    <table class="data">
      {% for key, value in context.design_rows %}
      <tr><th>{{ key }}</th><td>{{ value }}</td></tr>
      {% endfor %}
    </table>
  </section>

  <section id="metrics">
    <h2>Per-metric summaries</h2>
    {% for metric in context.metrics %}
    <h3>{{ metric }}</h3>
    <div class="figure">{{ context.boxplots[metric] | safe }}</div>
    {% endfor %}
    <h3>Kaplan–Meier (MET-03)</h3>
    <div class="figure">{{ context.km_figure | safe }}</div>
    {% for label, svg in context.discovery_figures.items() %}
    <h3>Discovery — {{ label }}</h3>
    <div class="figure">{{ svg | safe }}</div>
    {% endfor %}
  </section>

  <section id="statistics">
    <h2>Statistics</h2>
    <table class="data">
      <tr>
        <th>Metric</th><th>Comparison</th><th>p</th><th>p (Holm)</th><th>Â12</th><th>Effect</th>
      </tr>
      {% for row in context.stats_rows %}
      <tr>
        <td>{{ row.metric }}</td>
        <td>{{ row.a_vs_b }}</td>
        <td>{{ row.p }}</td>
        <td>{{ row.p_holm }}</td>
        <td>{{ row.a12 }}</td>
        <td>{{ row.effect }}</td>
      </tr>
      {% endfor %}
    </table>
    <p class="muted">All strategies: {% for s in context.strategies %}{{ s }}{% if not loop.last %}, {% endif %}{% endfor %}</p>
  </section>

  <section id="threats">
    <h2>Threats to validity</h2>
    <ul>
      {% for t in context.threats %}<li>{{ t }}</li>{% endfor %}
    </ul>
  </section>

  <script type="application/json" id="experiment-comparison">{{ context.comparison | tojson }}</script>
  <footer class="footer">RoboProbe · Experiment report · offline HTML</footer>
</body>
</html>