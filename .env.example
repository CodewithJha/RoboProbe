# RoboProbe environment template — GENERATED by scripts/gen_config_docs.py; do not edit by hand.
# Copy to .env (git-ignored) and uncomment only what you need (docs/27).
# Variables use the ROBOPROBE_ prefix with "__" as the nested delimiter, e.g.
#   ROBOPROBE_RUNNER__TICK_INTERVAL_S=0.5  ->  runner.tick_interval_s
# Values shown are the defaults. Never put real secrets here: use the files in
# ROBOPROBE_SECRETS_DIR (default /run/secrets: db_password, api_token) instead.
# ROBOPROBE_CONFIG_FILE and ROBOPROBE_SECRETS_DIR are read from the process environment only.

# --- core ---
# Deployment environment.
# ROBOPROBE_ENV=local

# --- database ---
# SQLAlchemy DSN of the RoboProbe database. Keep the password out of the URL and use `password_file`
# or the `db_password` secret file instead.
# ROBOPROBE_DATABASE__URL=postgresql+psycopg://roboprobe@localhost:5432/roboprobe
# File holding the database password; merged into `url` [path].
# ROBOPROBE_DATABASE__PASSWORD_FILE=
# Connection pool size per process.
# ROBOPROBE_DATABASE__POOL_SIZE=5
# Server-side statement timeout [ms].
# ROBOPROBE_DATABASE__STATEMENT_TIMEOUT_MS=30000
# PostgreSQL LISTEN/NOTIFY channel for live events.
# ROBOPROBE_DATABASE__NOTIFY_CHANNEL=roboprobe_events

# --- storage ---
# Root directory of run artefacts [path].
# ROBOPROBE_STORAGE__ARTIFACT_ROOT=data/artifacts
# Root of per-run scratch directories [path].
# ROBOPROBE_STORAGE__WORKDIR_ROOT=data/workdirs
# Free-space floor that raises `DISK_LOW` [GB].
# ROBOPROBE_STORAGE__MIN_FREE_GB=5.0
# Days to keep rosbag artefacts [d].
# ROBOPROBE_STORAGE__RETENTION__BAGS_DAYS=30
# Keep bags of failing runs regardless of `bags_days`.
# ROBOPROBE_STORAGE__RETENTION__KEEP_FAILURE_BAGS=true
# Artifact store plugin key in the `roboprobe.stores` entry-point group.
# ROBOPROBE_STORAGE__BACKEND=local

# --- api ---
# Bind address; any non-loopback address requires `api.token`.
# ROBOPROBE_API__HOST=127.0.0.1
# Listen port.
# ROBOPROBE_API__PORT=8000
# URL prefix of the versioned API.
# ROBOPROBE_API__BASE_PATH=/api/v1
# Bearer token required on every request (and for any non-loopback `host`).
# ROBOPROBE_API__TOKEN=
# Origins allowed by CORS (dev server and dashboard).
# ROBOPROBE_API__CORS_ORIGINS=["http://localhost:5173", "http://localhost:8080"]
# Maximum request body size [MB].
# ROBOPROBE_API__MAX_UPLOAD_MB=10
# Default page size [items].
# ROBOPROBE_API__PAGE_LIMIT_DEFAULT=50
# Maximum page size [items].
# ROBOPROBE_API__PAGE_LIMIT_MAX=500
# Keep-alive ping interval on SSE streams [s].
# ROBOPROBE_API__SSE__PING_INTERVAL_S=15.0
# Retention of idempotency keys [s].
# ROBOPROBE_API__IDEMPOTENCY_TTL_S=86400

# --- runner ---
# Campaign loop tick [s].
# ROBOPROBE_RUNNER__TICK_INTERVAL_S=1.0
# Target in-flight runs = workers x factor.
# ROBOPROBE_RUNNER__INFLIGHT_FACTOR=1.5
# Reaper sweep interval [s].
# ROBOPROBE_RUNNER__REAPER_INTERVAL_S=10.0
# Heartbeat age after which a run is reaped [s].
# ROBOPROBE_RUNNER__HEARTBEAT_TIMEOUT_S=30.0
# Run attempts (1 + retries).
# ROBOPROBE_RUNNER__MAX_ATTEMPTS=3
# Maximum runs per campaign.
# ROBOPROBE_RUNNER__MAX_BUDGET=20000
# Maximum proposals per batch.
# ROBOPROBE_RUNNER__MAX_BATCH_SIZE=32
# INVALID share that pauses a campaign [0-1].
# ROBOPROBE_RUNNER__AUTO_PAUSE__INVALID_RATIO=0.2
# Finished runs before `invalid_ratio` is evaluated.
# ROBOPROBE_RUNNER__AUTO_PAUSE__MIN_RUNS=20
# Consecutive INVALID runs that pause a campaign.
# ROBOPROBE_RUNNER__AUTO_PAUSE__MAX_CONSECUTIVE_INVALID=10
# Emit NO_WORKERS when a RUNNING campaign has no worker this long [s].
# ROBOPROBE_RUNNER__ALERTS__NO_WORKERS_AFTER_S=60.0
# Emit GP_FALLBACK_REPEATED after this many consecutive selector fallbacks.
# ROBOPROBE_RUNNER__ALERTS__GP_FALLBACK_REPEAT=3
# Re-run incremental failure analysis every N finished runs.
# ROBOPROBE_RUNNER__ANALYSIS__INCREMENTAL_EVERY_N=25
# Whether INVALID runs consume campaign budget.
# ROBOPROBE_RUNNER__COUNT_INVALID_IN_BUDGET=false
# Attempts including the first.
# ROBOPROBE_RUNNER__RETRY__MAX_ATTEMPTS=3
# First backoff delay [s].
# ROBOPROBE_RUNNER__RETRY__BASE_DELAY_S=0.5
# Backoff delay cap [s].
# ROBOPROBE_RUNNER__RETRY__MAX_DELAY_S=10.0
# Campaigns driven concurrently per orchestrator.
# ROBOPROBE_RUNNER__MAX_CONCURRENT_CAMPAIGNS=4

# --- worker ---
# Simulator backend key (`kinematic2d`, `gazebo_nav2`); required to start a worker.
# ROBOPROBE_WORKER__BACKEND=
# Worker id prefix; id = `<prefix>:<pid>:<slot>` (default: host name).
# ROBOPROBE_WORKER__ID_PREFIX=<hostname>
# Simulation slots per process.
# ROBOPROBE_WORKER__CONCURRENCY=1
# Queue poll interval [s].
# ROBOPROBE_WORKER__POLL_INTERVAL_S=1.0
# Heartbeat interval [s].
# ROBOPROBE_WORKER__HEARTBEAT_INTERVAL_S=5.0
# Max wait when joining the heartbeat thread on stop [s].
# ROBOPROBE_WORKER__HEARTBEAT_JOIN_TIMEOUT_S=10.0
# Grace period to finish runs on SIGTERM [s].
# ROBOPROBE_WORKER__DRAIN_TIMEOUT_S=600.0
# Default wall-clock limit per run [s].
# ROBOPROBE_WORKER__DEFAULT_WALL_TIMEOUT_S=300.0
# Default simulated-time budget per run [s].
# ROBOPROBE_WORKER__DEFAULT_SIM_TIME_BUDGET_S=120.0
# Bind address for the worker `/healthz` + metrics server.
# ROBOPROBE_WORKER__HEALTH_HOST=127.0.0.1
# Internal `/healthz` + metrics port.
# ROBOPROBE_WORKER__HEALTH_PORT=9101

# --- backends ---
# Integration time step [s].
# ROBOPROBE_BACKENDS__KINEMATIC2D__DT=0.05
# Trace sampling rate [Hz].
# ROBOPROBE_BACKENDS__KINEMATIC2D__SAMPLE_HZ=20.0
# Simulated lidar beams.
# ROBOPROBE_BACKENDS__KINEMATIC2D__LIDAR_BEAMS=180
# Simulated depth-camera beams.
# ROBOPROBE_BACKENDS__KINEMATIC2D__DEPTH_BEAMS=60
# Robot, controller and planner constants (calibrated in T-034) [path].
# ROBOPROBE_BACKENDS__KINEMATIC2D__MODEL_FILE=configs/backends/kinematic2d_v1.yaml
# Worker image reference recorded in run manifests (informational).
# ROBOPROBE_BACKENDS__GAZEBO_NAV2__IMAGE=ghcr.io/codewithjha/roboprobe-gazebo:${tag}
# ROS package of the launch.
# ROBOPROBE_BACKENDS__GAZEBO_NAV2__LAUNCH_PACKAGE=roboprobe_ros
# Episode launch file.
# ROBOPROBE_BACKENDS__GAZEBO_NAV2__LAUNCH_FILE=episode.launch.py
# Topic and frame names used by the ROS nodes [path].
# ROBOPROBE_BACKENDS__GAZEBO_NAV2__TOPICS_FILE=ros_ws/src/roboprobe_ros/config/topics.yaml
# Package-relative base world patched per scenario.
# ROBOPROBE_BACKENDS__GAZEBO_NAV2__BASE_WORLD=nav2_minimal_tb4_sim/worlds/warehouse.sdf
# Package-relative Nav2 parameter file overlaid per SUT profile.
# ROBOPROBE_BACKENDS__GAZEBO_NAV2__BASE_NAV2_PARAMS=nav2_bringup/params/nav2_params.yaml
# Run Gazebo without a GUI.
# ROBOPROBE_BACKENDS__GAZEBO_NAV2__HEADLESS_RENDERING=true
# Force Mesa software rendering (`LIBGL_ALWAYS_SOFTWARE=1`).
# ROBOPROBE_BACKENDS__GAZEBO_NAV2__SOFTWARE_RENDERING=false
# Target real-time factor of the simulation.
# ROBOPROBE_BACKENDS__GAZEBO_NAV2__PHYSICS__REAL_TIME_FACTOR=1.0
# ROS 2 middleware implementation.
# ROBOPROBE_BACKENDS__GAZEBO_NAV2__RMW=rmw_cyclonedds_cpp
# First `ROS_DOMAIN_ID`; each worker slot adds its index.
# ROBOPROBE_BACKENDS__GAZEBO_NAV2__DOMAIN_ID_BASE=30
# Time allowed for Nav2 to become ACTIVE [s].
# ROBOPROBE_BACKENDS__GAZEBO_NAV2__STARTUP_TIMEOUT_S=60.0
# SIGTERM-to-SIGKILL grace on episode teardown [s].
# ROBOPROBE_BACKENDS__GAZEBO_NAV2__TEARDOWN_GRACE_S=10.0
# Trace sampling rate [Hz].
# ROBOPROBE_BACKENDS__GAZEBO_NAV2__SAMPLE_HZ=20.0
# When to record rosbag2 MCAP: never, failures, always.
# ROBOPROBE_BACKENDS__GAZEBO_NAV2__RECORD_BAG=failures
# Gazebo episodes allowed in parallel on one host.
# ROBOPROBE_BACKENDS__GAZEBO_NAV2__MAX_PARALLEL_PER_HOST=1
# Perception degradation constants (docs/06 §3.3) [path].
# ROBOPROBE_BACKENDS__GAZEBO_NAV2__PERCEPTION_MODEL_FILE=configs/perception/oakd_lowlight_v1.yaml

# --- scenario ---
# Sampler draws before rejection sampling of constrained spaces gives up.
# ROBOPROBE_SCENARIO__CONSTRAINT_MAX_ATTEMPTS=1000

# --- selection ---
# Warm-up share of the budget [0-1].
# ROBOPROBE_SELECTION__PROBE__N0_FRACTION=0.1
# Minimum warm-up runs as a multiple of the dimension d.
# ROBOPROBE_SELECTION__PROBE__N0_MIN_FACTOR=2
# Mode-search share.
# ROBOPROBE_SELECTION__PROBE__WEIGHTS__MODE_SEARCH=0.6
# Boundary-refinement share.
# ROBOPROBE_SELECTION__PROBE__WEIGHTS__BOUNDARY=0.25
# Local refinement share.
# ROBOPROBE_SELECTION__PROBE__WEIGHTS__REFINE=0.15
# Random exploration share.
# ROBOPROBE_SELECTION__PROBE__EPSILON=0.05
# Diversity penalty weight.
# ROBOPROBE_SELECTION__PROBE__LAMBDA_DIV=1.0
# Diversity radius in GP length-scales.
# ROBOPROBE_SELECTION__PROBE__KAPPA_RADIUS=0.5
# Straddle (LSE) beta.
# ROBOPROBE_SELECTION__PROBE__BETA_STRADDLE=1.96
# Boundary bisection steps.
# ROBOPROBE_SELECTION__PROBE__REFINE_BISECT_STEPS=4
# Perturbations per refined point.
# ROBOPROBE_SELECTION__PROBE__REFINE_PERTURB_N=4
# Perturbation std in the unit cube.
# ROBOPROBE_SELECTION__PROBE__REFINE_PERTURB_STD=0.05
# Window for phase-weight adaptation.
# ROBOPROBE_SELECTION__PROBE__ADAPT_WINDOW=20
# Training points kept by the GP.
# ROBOPROBE_SELECTION__GP__MAX_POINTS=1500
# Likelihood noise floor.
# ROBOPROBE_SELECTION__GP__NOISE_LOWER_BOUND=0.0001
# Torch intra-op threads.
# ROBOPROBE_SELECTION__GP__TORCH_THREADS=4
# Optimiser restarts.
# ROBOPROBE_SELECTION__ACQ__NUM_RESTARTS=10
# Raw samples for initialisation.
# ROBOPROBE_SELECTION__ACQ__RAW_SAMPLES=512
# Optimiser iterations.
# ROBOPROBE_SELECTION__ACQ__MAXITER=200
# Distance under which candidates are duplicates.
# ROBOPROBE_SELECTION__ACQ__DEDUPE_TOL=0.001
# Levels in the unit interval, strictly increasing.
# ROBOPROBE_SELECTION__OFAT__LEVELS=[0.0, 0.25, 0.5, 0.75, 1.0]
# Minimum levels per axis.
# ROBOPROBE_SELECTION__GRID__MIN_LEVELS=2
# Refresh the failure-mode cache every N observations.
# ROBOPROBE_SELECTION__MODE_CACHE_REFRESH_EVERY=10
# Time limit for `propose` before falling back [s].
# ROBOPROBE_SELECTION__PROPOSE_TIMEOUT_S=10.0

# --- oracles ---
# Clearance normaliser [m].
# ROBOPROBE_ORACLES__CLEAR__D_NORM=0.5
# Near-miss (F-NEAR) distance [m].
# ROBOPROBE_ORACLES__CLEAR__D_SAFE=0.1
# Robustness magnitude of a zero-speed contact.
# ROBOPROBE_ORACLES__CLEAR__R_CONTACT_BASE=0.1
# Impact speed normaliser [m/s].
# ROBOPROBE_ORACLES__CLEAR__V_REF=0.5
# Minimum robustness magnitude when not reached.
# ROBOPROBE_ORACLES__GOAL__R_MIN=0.01
# Progress window [s].
# ROBOPROBE_ORACLES__PROG__WINDOW_S=10.0
# Minimum progress per window [m].
# ROBOPROBE_ORACLES__PROG__DELTA_MIN=0.05
# Progress normaliser [m].
# ROBOPROBE_ORACLES__PROG__DELTA_NORM=0.5
# Maximum tolerated pose error [m].
# ROBOPROBE_ORACLES__LOC__E_MAX=0.5
# Time the error must persist [s].
# ROBOPROBE_ORACLES__LOC__HOLD_S=2.0
# Robustness assigned to a navigation abort.
# ROBOPROBE_ORACLES__NAV__R_ABORT=-0.5
# Maximum roll/pitch [rad].
# ROBOPROBE_ORACLES__STAB__THETA_MAX=0.35
# Maximum angular rate [rad/s].
# ROBOPROBE_ORACLES__STAB__OMEGA_MAX=3.0
# Sliding window [s].
# ROBOPROBE_ORACLES__OSC__WINDOW_S=5.0
# Yaw-rate magnitude counted as a swing [rad/s].
# ROBOPROBE_ORACLES__OSC__OMEGA_MIN=0.3
# Sign changes per window before violation.
# ROBOPROBE_ORACLES__OSC__N_MAX=6
# Largest allowed sampling gap [s].
# ROBOPROBE_ORACLES__INFRA__MAX_GAP_S=1.0
# Minimum mean real-time factor.
# ROBOPROBE_ORACLES__INFRA__MIN_RTF=0.2
# Time allowed for the stack to become ACTIVE [s].
# ROBOPROBE_ORACLES__INFRA__STARTUP_TIMEOUT_S=60.0
# Allowed deviation of the spawn pose [m].
# ROBOPROBE_ORACLES__INFRA__SPAWN_TOLERANCE_M=0.2

# --- analysis ---
# Scenario-parameter block weight.
# ROBOPROBE_ANALYSIS__FEATURE_WEIGHTS__PARAM=1.0
# Failure-class block weight.
# ROBOPROBE_ANALYSIS__FEATURE_WEIGHTS__CLASS=0.75
# Trajectory-feature block weight.
# ROBOPROBE_ANALYSIS__FEATURE_WEIGHTS__TRAJ=0.5
# Minimum cluster size as a share of failures.
# ROBOPROBE_ANALYSIS__HDBSCAN__MIN_CLUSTER_FRACTION=0.03
# Absolute minimum cluster size.
# ROBOPROBE_ANALYSIS__HDBSCAN__MIN_CLUSTER_SIZE_FLOOR=3
# Jaccard overlap that matches modes across runs.
# ROBOPROBE_ANALYSIS__MODE_MATCH_JACCARD=0.5
# Coverage for a parameter range to be characteristic.
# ROBOPROBE_ANALYSIS__CHARACTERISTIC_COVERAGE=0.5
# Maximum tree depth.
# ROBOPROBE_ANALYSIS__GBM__MAX_DEPTH=4
# Learning rate.
# ROBOPROBE_ANALYSIS__GBM__LEARNING_RATE=0.1
# Boosting iterations.
# ROBOPROBE_ANALYSIS__GBM__MAX_ITER=200
# Cross-validation folds.
# ROBOPROBE_ANALYSIS__CV_FOLDS=5
# Failures needed before results are flagged confident.
# ROBOPROBE_ANALYSIS__MIN_FAILURES_CONFIDENT=10
# Maximum rule depth.
# ROBOPROBE_ANALYSIS__RULES__MAX_DEPTH=4
# Minimum precision of a reported rule.
# ROBOPROBE_ANALYSIS__RULES__MIN_PRECISION=0.6
# Confirmation repeats per candidate.
# ROBOPROBE_ANALYSIS__INTERACTION__REPEATS=3
# Share of repeats that must reproduce the failure.
# ROBOPROBE_ANALYSIS__INTERACTION__SUCCESS_RATIO=0.67

# --- risk ---
# Upper bound of the safe region.
# ROBOPROBE_RISK__THRESHOLDS__SAFE=0.05
# Lower bound of the failure-prone region.
# ROBOPROBE_RISK__THRESHOLDS__FAILURE=0.95
# Grid points per axis of a 2-D slice.
# ROBOPROBE_RISK__SLICE_RESOLUTION=50
# Monte-Carlo samples for region volume estimates.
# ROBOPROBE_RISK__VOLUME_SAMPLES=8192

# --- experiments ---
# Seeds per strategy and design.
# ROBOPROBE_EXPERIMENTS__DEFAULT_SEEDS=30
# Campaigns an experiment runs concurrently.
# ROBOPROBE_EXPERIMENTS__MAX_CONCURRENT_CAMPAIGNS=2
# Bootstrap resamples for confidence intervals.
# ROBOPROBE_EXPERIMENTS__BOOTSTRAP_RESAMPLES=10000
# Significance level.
# ROBOPROBE_EXPERIMENTS__ALPHA=0.05
# Reference scenarios.
# ROBOPROBE_EXPERIMENTS__REFERENCE_SET__N=20000
# Seed of the reference sample.
# ROBOPROBE_EXPERIMENTS__REFERENCE_SET__SEED=20261119
# Unit-cube radius matching a found mode to a true one.
# ROBOPROBE_EXPERIMENTS__MODE_MATCH_RADIUS=0.05
# Bins per axis for coverage metrics.
# ROBOPROBE_EXPERIMENTS__COVERAGE_BINS=5

# --- observability ---
# Expose Prometheus metrics.
# ROBOPROBE_OBSERVABILITY__METRICS_ENABLED=true
# OTLP collector URL; tracing is off when unset.
# ROBOPROBE_OBSERVABILITY__OTLP_ENDPOINT=
# Service name in logs/traces; derived per process (`roboprobe-api`, ...).
# ROBOPROBE_OBSERVABILITY__SERVICE_NAME=

# --- logging ---
# Minimum log level.
# ROBOPROBE_LOGGING__LEVEL=INFO
# `json` (prod/ci) or `console` (human-readable local output).
# ROBOPROBE_LOGGING__FORMAT=json
# Add module/function/line to logs.
# ROBOPROBE_LOGGING__INCLUDE_CALLER=false

# --- Docker Compose (docs/27 §4.12) ---
# Image tag of the RoboProbe containers.
# ROBOPROBE_IMAGE_TAG=dev
# Host port published for the API.
# ROBOPROBE_API_PORT=8000
# Host port published for the dashboard.
# ROBOPROBE_WEB_PORT=8080
# PostgreSQL database name.
# ROBOPROBE_DB_NAME=roboprobe
# PostgreSQL user name.
# ROBOPROBE_DB_USER=roboprobe
# Loopback host port for Postgres (dev profile only).
# ROBOPROBE_DB_PORT=5432
# Number of kinematic2d worker containers.
# ROBOPROBE_K2D_REPLICAS=2
