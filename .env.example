# RoboProbe environment template (docs/27). Copy to .env (git-ignored) and edit only what you need.
# Variables use the ROBOPROBE_ prefix with "__" as the nested delimiter, e.g.
#   ROBOPROBE_RUNNER__TICK_INTERVAL_S=0.5  ->  runner.tick_interval_s
# Values below are the documented safe defaults. This file must never contain real secrets:
# provide them through files in ROBOPROBE_SECRETS_DIR (default /run/secrets) instead.

# --- Core (docs/27 §2, §4.1) ---
ROBOPROBE_ENV=local
# ROBOPROBE_CONFIG_FILE=./roboprobe.toml
# ROBOPROBE_SECRETS_DIR=/run/secrets

# --- Database (docs/27 §4.1) ---
ROBOPROBE_DATABASE__URL=postgresql+psycopg://roboprobe@localhost:5432/roboprobe
# ROBOPROBE_DATABASE__PASSWORD_FILE=/run/secrets/db_password
# ROBOPROBE_DATABASE__POOL_SIZE=5

# --- Storage (docs/27 §4.2) ---
# ROBOPROBE_STORAGE__ARTIFACT_ROOT=./data/artifacts
# ROBOPROBE_STORAGE__WORKDIR_ROOT=./data/workdirs

# --- API (docs/27 §4.3) ---
# ROBOPROBE_API__HOST=127.0.0.1
# ROBOPROBE_API__PORT=8000
# Required when the API binds a non-loopback host. Prefer a secret file over setting it here.
# ROBOPROBE_API_TOKEN=

# --- Worker (docs/27 §4.4) ---
# ROBOPROBE_WORKER__BACKEND=kinematic2d
# ROBOPROBE_WORKER__CONCURRENCY=1

# --- Logging (docs/27 §4.10) ---
# ROBOPROBE_LOGGING__LEVEL=INFO
# ROBOPROBE_LOGGING__FORMAT=json        # "console" for human-readable local output

# --- Docker Compose (docs/27 §4.12) ---
ROBOPROBE_IMAGE_TAG=dev
ROBOPROBE_API_PORT=8000
ROBOPROBE_WEB_PORT=8080
ROBOPROBE_DB_NAME=roboprobe
ROBOPROBE_DB_USER=roboprobe
ROBOPROBE_K2D_REPLICAS=2
