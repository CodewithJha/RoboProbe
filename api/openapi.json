  "info": {
    "title": "RoboProbe API",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/events": {
      "get": {
        "description": "Stream outbox events. ``Last-Event-ID`` resumes after that id.",
        "operationId": "stream_events_api_v1_events_get",
        "parameters": [
          {
            "in": "query",
            "name": "campaign_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Campaign Id"
            }
          },
          {
            "in": "query",
            "name": "last_event_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Last Event Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Stream Events",
        "tags": [
          "events"
        ]
      }
    },
    "/api/v1/meta": {
      "get": {
        "description": "Return version, git SHA and registered plugins.",
        "operationId": "meta_api_v1_meta_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Meta Api V1 Meta Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Meta",
        "tags": [
          "meta"
        ]
      }
    },
    "/api/v1/spaces": {
      "get": {
        "description": "Return one keyset page of spaces, ordered by ``id`` then ``version``.",
        "operationId": "list_spaces_api_v1_spaces_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Limit"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_SpaceSummary_"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List registered scenario spaces",
        "tags": [
          "spaces"
        ]
      },
      "post": {
        "description": "Register a YAML/JSON space; identical content is idempotent (200, same version).",
        "operationId": "register_space_api_v1_spaces_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            },
            "application/yaml": {
              "schema": {
                "type": "object"
              }
            }
          },
          "description": "Scenario-space document (YAML or JSON; JSON is valid YAML).",
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpaceVersion"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Validate and register a scenario space",
        "tags": [
          "spaces"
        ]
      }
    },
    "/api/v1/spaces/validate": {
      "post": {
        "description": "Validate a YAML/JSON space; invalid input still returns 200 with ``valid: false``.",
        "operationId": "validate_space_api_v1_spaces_validate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            },
            "application/yaml": {
              "schema": {
                "type": "object"
              }
            }
          },
          "description": "Scenario-space document (YAML or JSON; JSON is valid YAML).",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpaceValidationResult"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Validate a scenario space without storing it",
        "tags": [
          "spaces"
        ]
      }
    },
    "/api/v1/spaces/{space_id}/versions/{version}": {
      "get": {
        "description": "Return the stored definition of ``(space_id, version)``.",
        "operationId": "get_space_version_api_v1_spaces__space_id__versions__version__get",
        "parameters": [
          {
            "in": "path",
            "name": "space_id",
            "required": true,
            "schema": {
              "title": "Space Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "version",
            "required": true,
            "schema": {
              "title": "Version",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpaceVersion"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get one stored space version",
        "tags": [
          "spaces"
        ]
      }
    },
    "/api/v1/sut-profiles": {
      "get": {
        "description": "Return one keyset page of robot-stack profiles, ordered by ``id``.",
        "operationId": "list_sut_profiles_api_v1_sut_profiles_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Limit"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_SutProfileDTO_"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List registered SUT profiles",
        "tags": [
          "sut-profiles"
        ]
      },
      "post": {
        "description": "Register a YAML/JSON profile; identical content is idempotent (200, same hash).",
        "operationId": "create_sut_profile_api_v1_sut_profiles_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            },
            "application/yaml": {
              "schema": {
                "type": "object"
              }
            }
          },
          "description": "SUT profile document (YAML or JSON; JSON is valid YAML).",
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SutProfileDTO"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Validate and register a SUT profile",
        "tags": [
          "sut-profiles"
        ]
      }
    },
    "/health/live": {
      "get": {
        "description": "Process is up.",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Live Health Live Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "description": "DB reachable, migrations at head, artefact root writable.",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    }
  }
}
