          "enabled_params",
          "schema_version"
        ],
        "title": "SpaceSummary",
        "type": "object"
      },
      "SpaceValidationResult": {
        "additionalProperties": false,
        "description": "Outcome of ``POST /spaces/validate`` (HTTP 200 even when invalid).",
        "properties": {
          "dimension": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dimension"
          },
          "enabled_params": {
            "default": [],
            "items": {
              "type": "string"
