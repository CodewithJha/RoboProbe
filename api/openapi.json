  "openapi": "3.1.0",
  "paths": {
    "/api/v1/events": {
      "get": {
        "description": "Stream outbox events. ``Last-Event-ID`` resumes after that id.",
        "operationId": "stream_events_api_v1_events_get",
        "parameters": [
          {
            "in": "query",
            "name": "campaign_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Campaign Id"
            }
          },
          {
            "in": "query",
            "name": "last_event_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Last Event Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Stream Events",
        "tags": [
          "events"
        ]
      }
    },
    "/api/v1/meta": {
      "get": {
        "description": "Return version, git SHA and registered plugins.",
        "operationId": "meta_api_v1_meta_get",
        "responses": {
